<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">

            <solid android:color="#FFDCD3" />

            <stroke
                android:width="2dp"
                android:color="#E9AEA4" />

        </shape>
    </item>

    <item>
        <shape android:shape="oval">

            <solid android:color="#FDE8E3" />

            <stroke
                android:width="2dp"
                android:color="#F1C6BC" />

        </shape>
    </item>

</selector>