<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FDF5EA" />

            <stroke
                android:width="1.5dp"
                android:color="#9E8F89" />

            <corners android:radius="2dp" />

            <size
                android:width="18dp"
                android:height="18dp" />

        </shape>
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="center"
        android:drawable="@drawable/ic_check_black" />

</layer-list>