<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#8F1747"
                android:centerColor="#D84E4E"
                android:endColor="#FF9A4E"
                android:angle="45"/>
        </shape>
    </item>

    <item
        android:left="22dp"
        android:right="22dp"
        android:top="22dp"
        android:bottom="22dp">

        <shape android:shape="oval">
            <solid android:color="#FFFDF9"/>
        </shape>

    </item>

</layer-list>