<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <solid android:color="#FFE0D5"/>

            <corners android:radius="14dp"/>

            <stroke
                android:width="1dp"
                android:color="#F5B9A7"/>

        </shape>

    </item>

    <item>

        <shape>

            <solid android:color="#FFF3E8"/>

            <corners android:radius="14dp"/>

            <stroke
                android:width="1dp"
                android:color="#EDD9CC"/>

        </shape>

    </item>

</selector>