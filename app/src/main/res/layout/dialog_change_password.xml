<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_logout_dialog"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- Lock icon circle -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_password_icon_circle">

        <ImageView
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_gravity="center"
            android:contentDescription="Change password"
            android:src="@drawable/ic_lock_outline" />

    </FrameLayout>

    <!-- Dialog title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Change Password"
        android:textColor="#4A3A3A"
        android:textSize="17sp" />

    <!-- Dialog subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Enter and confirm your new password"
        android:textColor="#756969"
        android:textSize="9sp" />

    <!-- New password label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="New Password"
        android:textColor="#4A3A3A"
        android:textSize="9sp" />

    <!-- New password field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="New password"
            android:src="@drawable/ic_lock_outline" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/poppins_regular"
            android:hint="Enter new password"
            android:inputType="textPassword"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="#4A3A3A"
            android:textColorHint="#A89B9B"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Confirm password label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Confirm Password"
        android:textColor="#4A3A3A"
        android:textSize="9sp" />

    <!-- Confirm password field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Confirm password"
            android:src="@drawable/ic_lock_outline" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/poppins_regular"
            android:hint="Confirm new password"
            android:inputType="textPassword"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="#4A3A3A"
            android:textColorHint="#A89B9B"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Cancel and Save buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cancel_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#FF654C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnSavePassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_logout_confirm_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Save Password"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>