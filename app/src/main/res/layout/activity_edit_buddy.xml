<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditBuddyActivity">

    <ImageView
        android:id="@+id/imgEditBuddyBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Edit buddy background"
        android:scaleType="centerCrop"
        android:src="@drawable/add_buddy_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnBackEditBuddy"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="44dp"
        android:clickable="true"
        android:contentDescription="Back"
        android:focusable="true"
        android:padding="3dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEditBuddyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Edit Buddy"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEditBuddySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Update your buddy's information"
        android:textColor="#F7DDE5"
        android:textSize="8sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEditBuddyTitle" />

    <FrameLayout
        android:id="@+id/btnChangePhoto"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_register_photo_circle"
        android:clickable="true"
        android:focusable="true"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/tvEditBuddySubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgBuddyPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_add_photo_camera"
            android:padding="22dp"
            android:contentDescription="Buddy Photo"/>

        <TextView
            android:id="@+id/tvChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="Change Photo"
            android:textSize="7sp"
            android:textColor="#8F1747"
            android:fontFamily="@font/poppins_semibold"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tvPhotoRequirement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="JPG or PNG (max 2 MB)"
        android:textColor="#8A7A76"
        android:textSize="7sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnChangePhoto" />

    <ScrollView
        android:id="@+id/editBuddyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPhotoRequirement">

        <LinearLayout
            android:id="@+id/editBuddyForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Full Name"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <EditText
                android:id="@+id/etEditBuddyName"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/poppins_regular"
                android:inputType="textPersonName"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:text="Sarah Iman"
                android:textColor="#4A3A3A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvEditGenderLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Gender"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <RadioGroup
                android:id="@+id/editGenderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/editRadioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FF6F61"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Male"
                    android:textColor="#756969"
                    android:textSize="9sp" />

                <RadioButton
                    android:id="@+id/editRadioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:buttonTint="#FF6F61"
                    android:checked="true"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Female"
                    android:textColor="#756969"
                    android:textSize="9sp" />

                <RadioButton
                    android:id="@+id/editRadioOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:buttonTint="#FF6F61"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Other"
                    android:textColor="#756969"
                    android:textSize="9sp" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Email Address"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Email"
                    android:src="@drawable/ic_email_outline" />

                <EditText
                    android:id="@+id/etEditBuddyEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="sarahiman@email.com"
                    android:textColor="#4A3A3A"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Phone Number"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Phone"
                    android:src="@drawable/ic_phone" />

                <EditText
                    android:id="@+id/etEditBuddyPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="phone"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="011-22334455"
                    android:textColor="#4A3A3A"
                    android:textSize="10sp" />
            </LinearLayout>
            <!-- Address Line 1 -->
            <TextView
                android:id="@+id/tvEditAddress1Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Address Line 1"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/editAddress1Container"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Address line 1"
                    android:src="@drawable/ic_location" />

                <EditText
                    android:id="@+id/etEditBuddyAddress1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="House no. / lot no. / building"
                    android:inputType="textPostalAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Address Line 2 -->
            <TextView
                android:id="@+id/tvEditAddress2Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Address Line 2"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/editAddress2Container"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Address line 2"
                    android:src="@drawable/ic_location" />

                <EditText
                    android:id="@+id/etEditBuddyAddress2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Street / taman / district"
                    android:inputType="textPostalAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Address Line 3 -->
            <TextView
                android:id="@+id/tvEditAddress3Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Address Line 3"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/editAddress3Container"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Address line 3"
                    android:src="@drawable/ic_location" />

                <EditText
                    android:id="@+id/etEditBuddyAddress3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Postcode and city"
                    android:inputType="textPostalAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="10sp" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvEditStateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="State"
                android:textColor="#4A3A3A"
                android:textSize="9sp" />

            <LinearLayout

                android:id="@+id/stateContainerEdit"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <TextView
                    android:id="@+id/tvSelectedStateEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Selangor"
                    android:textColor="#4A3A3A"
                    android:textSize="10sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Select state"
                    android:padding="2dp"
                    android:src="@drawable/ic_arrow_down" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancelEditBuddy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cancel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="#FF6F61"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnSaveChanges"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_save_buddy_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Save Changes"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>