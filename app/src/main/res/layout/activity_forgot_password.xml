<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForgotPasswordActivity">

    <!-- Same background as Login -->
    <ImageView
        android:id="@+id/imgForgotBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Forgot password background"
        android:scaleType="centerCrop"
        android:src="@drawable/login_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/forgotPasswordScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="760dp"
            android:paddingBottom="35dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnBackForgot"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="45dp"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgForgotLogo"
                android:layout_width="300dp"
                android:layout_height="80dp"
                android:layout_marginTop="75dp"
                android:adjustViewBounds="true"
                android:contentDescription="BuddyBook logo"
                android:scaleType="fitCenter"
                android:src="@drawable/buddybook_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvForgotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Reset Password"
                android:textColor="#75243F"
                android:textSize="17sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgForgotLogo" />

            <TextView
                android:id="@+id/tvForgotSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Verify your identity to create a new password"
                android:textColor="#756969"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotTitle" />

            <!--Email-->
            <TextView
                android:id="@+id/tvForgotEmailLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Email"
                android:textColor="#4A3A3A"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotSubtitle" />

            <LinearLayout
                android:id="@+id/forgotNameContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotEmailLabel">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="Email"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etForgotEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Enter your email"
                    android:inputType="textPersonName"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Security question -->
            <TextView
                android:id="@+id/tvForgotQuestionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Security Question"
                android:textColor="#4A3A3A"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forgotNameContainer" />

            <Spinner
                android:id="@+id/spForgotSecurityQuestion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:popupBackground="@drawable/bg_spinner_popup"
                android:spinnerMode="dropdown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotQuestionLabel" />

            <!-- Security answer -->
            <TextView
                android:id="@+id/tvForgotAnswerLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Security Answer"
                android:textColor="#4A3A3A"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/spForgotSecurityQuestion" />

            <LinearLayout
                android:id="@+id/forgotAnswerContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotAnswerLabel">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="Security answer"
                    android:src="@drawable/ic_lock_outline" />

                <EditText
                    android:id="@+id/etForgotSecurityAnswer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Enter your security answer"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Verify button -->
            <TextView
                android:id="@+id/btnVerifyIdentity"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/login_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Verify Identity"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forgotAnswerContainer" />

            <View
                android:id="@+id/forgotDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="50dp"
                android:background="#E6D8D0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVerifyIdentity" />

            <!-- New password -->
            <TextView
                android:id="@+id/tvNewPasswordLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="17dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="New Password"
                android:textColor="#9D9292"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forgotDivider" />

            <LinearLayout
                android:id="@+id/newPasswordContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="24dp"
                android:alpha="0.50"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNewPasswordLabel">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="New password"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etNewResetPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/imgNewResetVisibility"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:clickable="false"
                    android:contentDescription="Show new password"
                    android:focusable="false"
                    android:padding="2dp"
                    android:src="@drawable/ic_visibility_off" />

            </LinearLayout>

            <!-- Confirm password -->
            <TextView
                android:id="@+id/tvConfirmResetPasswordLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Confirm Password"
                android:textColor="#9D9292"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/newPasswordContainer" />

            <LinearLayout
                android:id="@+id/confirmResetPasswordContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="24dp"
                android:alpha="0.50"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvConfirmResetPasswordLabel">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="Confirm password"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etConfirmResetPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Confirm new password"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#4A3A3A"
                    android:textColorHint="#A89B9B"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/imgConfirmResetVisibility"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:clickable="false"
                    android:contentDescription="Show confirm password"
                    android:focusable="false"
                    android:padding="2dp"
                    android:src="@drawable/ic_visibility_off" />

            </LinearLayout>

            <!-- Initially disabled -->
            <TextView
                android:id="@+id/btnResetPassword"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:alpha="0.45"
                android:background="@drawable/login_button_selector"
                android:clickable="false"
                android:enabled="false"
                android:focusable="false"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Reset Password"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/confirmResetPasswordContainer" />

            <TextView
                android:id="@+id/tvReturnToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Return to Login"
                android:textColor="#FF6F61"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnResetPassword" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>