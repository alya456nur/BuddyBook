<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_state_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvStateDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="Select State"
        android:textColor="#8F1747"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Choose a state or federal territory"
        android:textColor="#756969"
        android:textSize="10sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/stateListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stateJohor"
                style="@style/StateDialogItem"
                android:text="Johor" />

            <TextView
                android:id="@+id/stateKedah"
                style="@style/StateDialogItem"
                android:text="Kedah" />

            <TextView
                android:id="@+id/stateKelantan"
                style="@style/StateDialogItem"
                android:text="Kelantan" />

            <TextView
                android:id="@+id/stateMelaka"
                style="@style/StateDialogItem"
                android:text="Melaka" />

            <TextView
                android:id="@+id/stateNegeriSembilan"
                style="@style/StateDialogItem"
                android:text="Negeri Sembilan" />

            <TextView
                android:id="@+id/statePahang"
                style="@style/StateDialogItem"
                android:text="Pahang" />

            <TextView
                android:id="@+id/statePenang"
                style="@style/StateDialogItem"
                android:text="Pulau Pinang" />

            <TextView
                android:id="@+id/statePerak"
                style="@style/StateDialogItem"
                android:text="Perak" />

            <TextView
                android:id="@+id/statePerlis"
                style="@style/StateDialogItem"
                android:text="Perlis" />

            <TextView
                android:id="@+id/stateSabah"
                style="@style/StateDialogItem"
                android:text="Sabah" />

            <TextView
                android:id="@+id/stateSarawak"
                style="@style/StateDialogItem"
                android:text="Sarawak" />

            <TextView
                android:id="@+id/stateSelangor"
                style="@style/StateDialogItem"
                android:text="Selangor" />

            <TextView
                android:id="@+id/stateTerengganu"
                style="@style/StateDialogItem"
                android:text="Terengganu" />

            <TextView
                android:id="@+id/stateKualaLumpur"
                style="@style/StateDialogItem"
                android:text="Kuala Lumpur" />

            <TextView
                android:id="@+id/stateLabuan"
                style="@style/StateDialogItem"
                android:text="Labuan" />

            <TextView
                android:id="@+id/statePutrajaya"
                style="@style/StateDialogItem"
                android:text="Putrajaya" />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/btnCloseStateDialog"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dialog_close_button"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="Close"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</LinearLayout>