<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_options_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/poppins_semibold"
        android:text="Create New Group"
        android:textColor="#4A3A3A"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Group Name"
        android:textColor="#4A3A3A"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etNewGroupName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/poppins_regular"
        android:hint="Enter group name"
        android:inputType="textCapWords"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:singleLine="true"
        android:textColor="#4A3A3A"
        android:textColorHint="#A89B9B"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelCreateGroup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cancel_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#FF6F61"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btnConfirmCreateGroup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_save_buddy_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Create Group"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>