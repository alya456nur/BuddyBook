<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardFamilyGroup"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_buddy_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/tvGroupNameInitial"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_register_photo_circle"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="F"
        android:textColor="#8F1747"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Group Name"
            android:textColor="#4A3A3A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCountMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="X Members"
            android:textColor="#8A7A76"
            android:textSize="8sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:contentDescription="Open details"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>