<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal application theme -->
    <style name="Theme.BuddyBook"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">#FF6F61</item>
        <item name="colorPrimaryVariant">#8F1747</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="android:fontFamily">@font/poppins_regular</item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @android:color/white
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>

    </style>

    <!-- Launch splash-screen theme -->
    <style name="Theme.BuddyBook.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">
            @color/splash_background
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.BuddyBook
        </item>

    </style>

</resources>